NODE_ENV=development
PORT=5000

# Prisma SQLite (local). For PostgreSQL, change prisma/schema.prisma provider to postgresql
# and use: postgresql://USER:PASSWORD@localhost:5432/sentinel
DATABASE_URL="file:./dev.db"

JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=60m
JWT_ALGORITHM=HS256

PYTHON_AI_SERVICE_URL=http://127.0.0.1:8000
INTERNAL_SERVICE_KEY=change-me-internal-service-key

CORS_ORIGIN=http://localhost:5173

UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=26214400
